# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG MẪU - WEBSITE KẾT VÒNG (.env.example)
# Sao chép file này thành .env và điền các giá trị thực tế trước khi khởi chạy.
# ==============================================================================

# Cổng dịch vụ Backend Hono (Mặc định: 3001)
PORT=3001

# URL Frontend công khai (Dùng để tạo link biên nhận và CORS)
PUBLIC_BASE_URL=https://ketvong.pages.dev
DEPLOYMENT_ENV=local

# URL Backend API (Dùng cho Webhook Simulator và Frontend)
VITE_API_URL=http://localhost:3001
API_URL=http://localhost:3001

# Đường dẫn file SQLite Database (Local dev)
DATABASE_PATH=./data/ketvong-payos.db

# Khóa bí mật ký JWT Session Admin (Tối thiểu 32 ký tự ngẫu nhiên)
# Tạo bằng lệnh: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=your_super_secret_session_key_min_32_chars_here

# Mật khẩu khởi tạo cho 1 tài khoản Admin khi chạy script `pnpm seed:admin`
# Bắt buộc đổi ở lần đăng nhập đầu tiên theo SRS-060
ADMIN_HUY_EMAIL=huy@ketvong.vn
ADMIN_HUY_PASSWORD=your_secure_password_for_huy_here

# PayOS
# Lấy tại trang quản trị PayOS sau khi tạo channel.
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_BASE_URL=https://api-merchant.payos.vn
PAYOS_RETURN_URL=http://localhost:3000/thanh-toan/ket-qua
PAYOS_CANCEL_URL=http://localhost:3000/thanh-toan/da-huy

# Gmail OAuth2 (Gửi mail cảm ơn tự động theo SRS-050)
# Lấy từ Google Cloud Console > APIs & Services > Credentials
GMAIL_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_client_secret_here
GMAIL_REFRESH_TOKEN=your_google_refresh_token_here
GMAIL_SENDER_EMAIL=your_email@gmail.com

# Chỉ bật để test email ngay khi bấm thanh toán; không phải xác nhận đã nhận tiền
SEND_CHECKOUT_EMAIL=false

# Tạm bỏ qua PayOS khi cổng thanh toán chưa sẵn sàng
BYPASS_PAYMENT=false
INVOICE_IMAGE_ALLOWED_HOSTS=

# Cloudflare Workers/D1 (chỉ dùng khi chạy Worker; không chứa secret)
# PUBLIC_BASE_URL=https://ketvong.example
# PAYOS_RETURN_URL=https://ketvong.example/thanh-toan/ket-qua
# PAYOS_CANCEL_URL=https://ketvong.example/thanh-toan/da-huy
