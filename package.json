{
  "name": "ketvong-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Website Kết Vòng — Quyên góp minh bạch tự động qua SePay",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"API,WEB\" -c \"cyan,magenta\" \"tsx apps/api/src/index.ts\" \"node apps/web/node_modules/vite/bin/vite.js apps/web --port 3000\"",
    "build": "tsx scripts/build.ts",
    "test": "tsx scripts/test.ts",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "seed:admin": "tsx packages/db/src/seed.ts",
    "webhook:simulate": "tsx apps/api/src/scripts/simulate-webhook.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
